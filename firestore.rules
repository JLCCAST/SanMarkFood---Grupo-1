rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdministrador() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    function esDecisionDelAdministrador() {
      let nuevo = request.resource.data;
      let cambios = nuevo.diff(resource.data).affectedKeys();
      return esAdministrador()
        && resource.data.estado == 'pendiente'
        && nuevo.revisadoEn == request.time
        && (
          (nuevo.estado == 'aprobado' && cambios.hasOnly(['estado', 'revisadoEn']))
          || (nuevo.estado == 'rechazado'
            && cambios.hasOnly(['estado', 'revisadoEn', 'rechazo'])
            && rechazoValido(nuevo.rechazo))
        );
    }

    function rechazoValido(rechazo) {
      return rechazo is map
        && rechazo.keys().hasAll(['motivos'])
        && rechazo.keys().hasOnly(['motivos', 'detalle'])
        && rechazo.motivos is list
        && rechazo.motivos.size() >= 1
        && rechazo.motivos.size() <= 4
        && rechazo.motivos.toSet().size() == rechazo.motivos.size()
        && rechazo.motivos.hasOnly(['datos_incompletos', 'direccion_no_verificable', 'local_duplicado', 'otro'])
        && (!('detalle' in rechazo) || (rechazo.detalle is string && rechazo.detalle.size() <= 200))
        && (!rechazo.motivos.hasAny(['otro']) || ('detalle' in rechazo && rechazo.detalle.size() >= 3));
    }

    function esDuenio(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read: if esDuenio(uid) || esAdministrador();
      allow create: if esDuenio(uid) && request.resource.data.rol in ['comensal', 'restaurante'];
      allow update: if esDuenio(uid) && request.resource.data.rol == resource.data.rol;
      allow delete: if false;

      match /dispositivos/{token} {
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['app', 'actualizadoEn'])
          && request.resource.data.app in ['restaurante', 'comensal']
          && request.resource.data.actualizadoEn == request.time;
      }
    }

    match /restaurantes/{uid} {
      function esDueno() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true;
      }
      function fotoDelLocal(url, tipo) {
        return url is string
          && url.matches('https://firebasestorage[.]googleapis[.]com/.*restaurantes%2F' + uid + '%2F' + tipo + '-[0-9]+[.]jpg.*');
      }
      function fotoDePlato(url) {
        return url is string
          && url.matches('https://firebasestorage[.]googleapis[.]com/.*restaurantes%2F' + uid + '%2Fplatos%2F[A-Za-z0-9]+-[0-9]+[.]jpg.*');
      }
      function datosValidos(d) {
        return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
          && d.categoria in ['criolla', 'chifa', 'polleria', 'marina', 'vegetariana', 'otra']
          && d.direccion is string && d.direccion.size() > 0 && d.direccion.size() <= 200
          && d.ubicacion is latlng
          && (!('telefono' in d) || (d.telefono is string && d.telefono.matches('(\\+51)?9[0-9]{8}')))
          && fotoDelLocal(d.portadaUrl, 'portada')
          && (!('logoUrl' in d) || fotoDelLocal(d.logoUrl, 'logo'));
      }
      function horaValida(h) {
        return h is string && h.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
      }
      function fechaValida(f) {
        return f is string && f.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }
      function precioValido(p) {
        return p is int && p > 0 && p <= 100000;
      }
      function diaValido(d) {
        return d is map
          && d.keys().hasAll(['abierto', 'abre', 'cierra']) && d.keys().hasOnly(['abierto', 'abre', 'cierra'])
          && d.abierto is bool && horaValida(d.abre) && horaValida(d.cierra)
          && (!d.abierto || d.abre < d.cierra);
      }
      function horarioValido(h) {
        return h is map
          && h.keys().hasAll(['lun', 'mar', 'mie', 'jue', 'vie', 'sab', 'dom'])
          && h.keys().hasOnly(['lun', 'mar', 'mie', 'jue', 'vie', 'sab', 'dom'])
          && diaValido(h.lun) && diaValido(h.mar) && diaValido(h.mie) && diaValido(h.jue)
          && diaValido(h.vie) && diaValido(h.sab) && diaValido(h.dom)
          && (h.lun.abierto || h.mar.abierto || h.mie.abierto || h.jue.abierto
              || h.vie.abierto || h.sab.abierto || h.dom.abierto);
      }
      function menuHoyValido(m) {
        return m is map
          && m.keys().hasAll(['fecha', 'precio', 'horaFin', 'estado'])
          && m.keys().hasOnly(['fecha', 'precio', 'horaFin', 'estado'])
          && fechaValida(m.fecha) && precioValido(m.precio) && horaValida(m.horaFin)
          && m.estado in ['publicado', 'terminado'];
      }
      function rangoCartaValido(r) {
        return r is map
          && r.keys().hasAll(['min', 'max']) && r.keys().hasOnly(['min', 'max'])
          && precioValido(r.min) && precioValido(r.max) && r.min <= r.max;
      }
      function camposDelLocal() {
        return ['nombre', 'categoria', 'direccion', 'ubicacion', 'telefono', 'portadaUrl', 'logoUrl'];
      }
      function camposSensibles() {
        return ['direccion', 'ubicacion', 'portadaUrl', 'logoUrl'];
      }
      function tocaCamposSensibles() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(camposSensibles());
      }
      function cambiaDatos() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nombre', 'categoria', 'direccion', 'ubicacion', 'telefono', 'portadaUrl', 'logoUrl', 'actualizadoEn'])
          && datosValidos(request.resource.data)
          && request.resource.data.actualizadoEn == request.time;
      }
      function cambiaDatosMenores() {
        return cambiaDatos()
          && (resource.data.estado != 'aprobado' || !tocaCamposSensibles());
      }
      function cambiaDatosSensibles() {
        let antes = resource.data;
        let despues = request.resource.data;
        let cambios = despues.diff(antes).affectedKeys();
        return antes.estado == 'aprobado'
          && despues.estado == 'pendiente'
          && cambios.hasAny(camposSensibles())
          && cambios.hasOnly([
               'nombre', 'categoria', 'direccion', 'ubicacion', 'telefono', 'portadaUrl', 'logoUrl',
               'estado', 'camposCorregidos', 'reenviado', 'rechazoAnterior', 'enviadoEn', 'actualizadoEn'])
          && !('reenviado' in despues)
          && !('rechazoAnterior' in despues)
          && despues.camposCorregidos is list
          && despues.camposCorregidos.hasOnly(camposDelLocal())
          && despues.camposCorregidos.hasAny(camposSensibles())
          && datosValidos(despues)
          && despues.enviadoEn == request.time
          && despues.actualizadoEn == request.time;
      }
      function enviaARevision() {
        return resource.data.estado == 'borrador'
          && 'portadaUrl' in resource.data
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['horario', 'estado', 'enviadoEn', 'actualizadoEn'])
          && horarioValido(request.resource.data.horario)
          && request.resource.data.enviadoEn == request.time
          && request.resource.data.actualizadoEn == request.time;
      }
      function cambiaHorario() {
        return resource.data.estado != 'borrador'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['horario', 'actualizadoEn'])
          && horarioValido(request.resource.data.horario)
          && request.resource.data.actualizadoEn == request.time;
      }
      function cambiaPausa() {
        return resource.data.estado == 'aprobado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pausado', 'actualizadoEn'])
          && request.resource.data.pausado is bool
          && request.resource.data.actualizadoEn == request.time;
      }
      function reenviaARevision() {
        return resource.data.estado == 'rechazado'
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'nombre', 'categoria', 'direccion', 'ubicacion', 'telefono', 'portadaUrl', 'logoUrl',
               'estado', 'rechazo', 'rechazoAnterior', 'reenviado', 'camposCorregidos', 'enviadoEn', 'actualizadoEn'])
          && !('rechazo' in request.resource.data)
          && request.resource.data.get('rechazoAnterior', null) == resource.data.get('rechazo', null)
          && request.resource.data.reenviado == true
          && request.resource.data.camposCorregidos is list
          && request.resource.data.camposCorregidos.hasOnly(['nombre', 'categoria', 'direccion', 'ubicacion', 'telefono', 'portadaUrl', 'logoUrl'])
          && datosValidos(request.resource.data)
          && request.resource.data.enviadoEn == request.time
          && request.resource.data.actualizadoEn == request.time;
      }
      function cambiaCarta() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['menuHoy', 'rangoCarta', 'actualizadoEn'])
          && (!('menuHoy' in request.resource.data) || menuHoyValido(request.resource.data.menuHoy))
          && (!('rangoCarta' in request.resource.data) || rangoCartaValido(request.resource.data.rangoCarta))
          && request.resource.data.actualizadoEn == request.time;
      }
      function cartaVisible() {
        return esDueno()
          || get(/databases/$(database)/documents/restaurantes/$(uid)).data.estado == 'aprobado';
      }
      function editaCarta() {
        return esDueno() && exists(/databases/$(database)/documents/restaurantes/$(uid));
      }

      allow read: if esDueno() || resource.data.estado == 'aprobado' || esAdministrador();

      allow create: if esDueno()
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'restaurante'
        && request.resource.data.keys().hasOnly(['nombre', 'categoria', 'direccion', 'ubicacion', 'telefono', 'portadaUrl', 'logoUrl', 'estado', 'creadoEn', 'actualizadoEn'])
        && datosValidos(request.resource.data)
        && request.resource.data.estado == 'borrador'
        && request.resource.data.creadoEn == request.time
        && request.resource.data.actualizadoEn == request.time;

      allow update: if (esDueno()
        && (cambiaDatosMenores() || cambiaDatosSensibles() || enviaARevision() || cambiaHorario()
            || cambiaPausa() || reenviaARevision() || cambiaCarta()))
        || esDecisionDelAdministrador();

      match /categorias/{categoriaId} {
        allow read: if cartaVisible() || esAdministrador();
        allow create, update: if editaCarta()
          && request.resource.data.keys().hasOnly(['nombre', 'orden'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 40
          && request.resource.data.orden is int;
        allow delete: if editaCarta();
      }

      match /platos/{platoId} {
        allow read: if cartaVisible() || esAdministrador();
        allow create, update: if editaCarta()
          && request.resource.data.keys().hasOnly(['nombre', 'descripcion', 'precio', 'categoriaId', 'fotoUrl', 'agotadoEl', 'creadoEn', 'actualizadoEn'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 80
          && (!('descripcion' in request.resource.data)
              || (request.resource.data.descripcion is string && request.resource.data.descripcion.size() <= 300))
          && precioValido(request.resource.data.precio)
          && request.resource.data.categoriaId is string
          && (!('fotoUrl' in request.resource.data) || fotoDePlato(request.resource.data.fotoUrl))
          && (!('agotadoEl' in request.resource.data) || fechaValida(request.resource.data.agotadoEl));
        allow delete: if editaCarta();
      }

      match /menus/{fecha} {
        allow read: if cartaVisible();
        allow create, update: if editaCarta()
          && fechaValida(fecha)
          && request.resource.data.keys().hasOnly(['precio', 'entradas', 'segundos', 'refresco', 'postre', 'horaFin', 'estado', 'origen', 'publicadoEn', 'actualizadoEn'])
          && precioValido(request.resource.data.precio)
          && request.resource.data.entradas is list
          && request.resource.data.segundos is list
          && horaValida(request.resource.data.horaFin)
          && request.resource.data.estado in ['publicado', 'terminado']
          && request.resource.data.origen in ['ayer', 'cero', 'ia'];
        allow delete: if false;
      }
    }
  }
}
